rules_version = '2';
// Apogée : chaque compte Google ne voit et ne modifie que ses propres données.
// À coller dans Console Firebase › Firestore Database › Règles, puis « Publier ».
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
